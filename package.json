{
  "name": "yolodeck",
  "version": "0.1.0",
  "description": "Stream Deck control surface for Claude Code sessions (Windows)",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "streamdeck dev",
    "link": "streamdeck link com.cruftbox.yolodeck.sdPlugin",
    "unlink": "streamdeck unlink com.cruftbox.yolodeck",
    "hooks:install": "node -e \"import('./scripts/hooks.mjs').then(m => m.install())\"",
    "hooks:uninstall": "node -e \"import('./scripts/hooks.mjs').then(m => m.uninstall())\"",
    "debug:hooks": "node scripts/debug-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "profile:build": "node scripts/build-profile.mjs",
    "statusline:install": "node scripts/statusline-config.mjs install",
    "statusline:uninstall": "node scripts/statusline-config.mjs uninstall"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cruftbox/yolodeck.git"
  },
  "author": "Michael Pusateri",
  "license": "MIT",
  "dependencies": {
    "@elgato/streamdeck": "^2.0.4",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.3",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.6",
    "rollup": "^4.60.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.6"
  }
}
